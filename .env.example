# DataForSEO (keyword volumes, difficulty, SERPs, backlinks). Pay-as-you-go: https://app.dataforseo.com/api-access
# Either login + API password...
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# ...or the Base64 "login:password" credential
# DATAFORSEO_API_KEY=

# Anthropic (questions, briefs, human-voice writing, page analysis)
ANTHROPIC_API_KEY=
# SEO_MODEL=claude-sonnet-5-5

# Google Search Console (optional, for sites you own): service-account JSON path.
# Add the service account's email as a user on the GSC property first.
# GSC_CREDENTIALS_PATH=

# Where project data is stored (default ./data)
# SEO_DATA_DIR=./data
